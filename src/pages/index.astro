---
import ContactCta from '../components/ContactCta.astro';
import Hero from '../components/Hero.astro';
import ProcessRail from '../components/ProcessRail.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Hero />

  <section class="capabilities-band" id="capabilities">
    <div class="shell capabilities-band__layout">
      <div class="section-heading capabilities-band__intro">
        <h2>Capabilities</h2>
        <p>Four connected areas for moving an idea toward something practical.</p>
      </div>
      <ol class="capability-list">
        {site.capabilities.map((capability) => (
          <li>
            <span>{capability.index}</span>
            <div>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="about-band" id="about">
    <div class="shell about-band__layout">
      <div class="section-heading about-band__copy">
        <h2>Who we are</h2>
        <p>
          Clever Cat Company is a multidisciplinary studio for people who need a thoughtful, hands-on route from
          idea to next step.
        </p>
        <p>
          We bring design, digital work, engineering, and creative production into the same conversation when that
          makes the work clearer and more useful.
        </p>
        <a class="text-link" href="/about">Learn about the studio <span aria-hidden="true">→</span></a>
      </div>
      <div class="about-band__diagram" aria-hidden="true">
        <svg viewBox="0 0 700 350" fill="none">
          <path d="M20 262C115 262 129 121 238 121c88 0 87 154 184 154 86 0 97-133 174-133 35 0 52 22 72 58" />
          <path d="M238 121c-16 61-16 104 0 154" class="about-band__loop" />
          <circle cx="119" cy="262" r="7" />
          <circle cx="238" cy="121" r="7" />
          <circle cx="422" cy="275" r="7" />
          <circle cx="596" cy="142" r="7" />
        </svg>
      </div>
    </div>
  </section>

  <WorkGrid />
  <ProcessRail />
  <ContactCta />
</BaseLayout>
