---
import ContactCta from '../components/ContactCta.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import CapabilityIcon from '../components/CapabilityIcon.astro';
import Hero from '../components/Hero.astro';
import ProcessRail from '../components/ProcessRail.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Hero />

  <section class="capabilities-band" id="capabilities">
    <div class="shell capabilities-band__layout">
      <div class="section-heading capabilities-band__intro">
        <h2>Capabilities</h2>
        <p>Four connected areas for moving an idea toward something practical.</p>
      </div>
      <ol class="capability-list">
        {site.capabilities.map((capability) => (
          <li>
            <span class="capability-list__index">{capability.index}</span>
            <CapabilityIcon index={capability.index} />
            <div>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="about-band" id="about">
    <div class="shell about-band__layout">
      <div class="section-heading about-band__copy">
        <h2>Who we are</h2>
        <p>
          Clever Cat Company is a multidisciplinary studio for people who need a thoughtful, hands-on route from
          idea to next step.
        </p>
        <p>
          We bring design, digital work, engineering, and creative production into the same conversation when that
          makes the work clearer and more useful.
        </p>
        <a class="text-link" href="/about">
          <span>Learn about the studio</span>
          <ArrowIcon class="text-link__icon" />
        </a>
      </div>
      <div class="about-band__diagram" aria-hidden="true">
        <svg viewBox="0 0 700 350" fill="none">
          <path d="M20 278h136l52-52h144l58-58h142l58-58h70" />
          <path d="M156 278v38h196m0-90v76h158m0-134v80h170" class="about-band__loop" />
          <circle cx="208" cy="226" r="7" />
          <circle cx="410" cy="168" r="7" />
          <circle cx="568" cy="110" r="7" />
        </svg>
      </div>
    </div>
  </section>

  <WorkGrid />
  <ProcessRail />
  <ContactCta />
</BaseLayout>
