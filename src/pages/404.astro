---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="Find your way back to the Clever Cat Company portfolio." noindex>
  <section class="not-found shell">
    <p class="eyebrow">404 / Page not found</p>
    <h1>Let's get you back to the work.</h1>
    <p>This address doesn't lead to a page in the portfolio.</p>
    <a class="button button--primary" href="/work/">Explore the projects <span aria-hidden="true">→</span></a>
    <a class="text-link" href="/">Return home</a>
  </section>
</BaseLayout>
