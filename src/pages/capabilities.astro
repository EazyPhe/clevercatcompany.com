---
import ContactCta from '../components/ContactCta.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Capabilities"
  description="Software and workflow, connected devices and control, and product design and fabrication at Clever Cat Company."
>
  <PageHero
    title="Capabilities"
    intro="Three connected disciplines for turning practical problems into clear, tangible work."
  />

  <section class="capability-detail">
    <div class="shell">
      <ol>
        {site.capabilities.map((capability) => (
          <li id={capability.id}>
            <span class="capability-detail__index">{capability.index}</span>
            <article>
              <h2>{capability.title}</h2>
              <p>{capability.description}</p>
              <ul>
                {capability.details.map((detail) => <li>{detail}</li>)}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <ContactCta />
</BaseLayout>
