---
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<section class="page-hero shell">
  <div>
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
  <svg class="page-hero__line" viewBox="0 0 500 220" fill="none" aria-hidden="true">
    <path d="M8 170h94l36-36h76l38-38h92l32-32h116" stroke="currentColor" stroke-width="2" />
    <path d="M102 170v30h108m42-104v70h92m32-102v64h116" stroke="currentColor" stroke-width="1" opacity=".55" />
    <circle cx="138" cy="134" r="6" fill="currentColor" />
    <circle cx="344" cy="96" r="6" fill="currentColor" />
    <circle cx="376" cy="64" r="6" fill="currentColor" />
  </svg>
</section>
