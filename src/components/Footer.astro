---
import { contactEmailHref, site } from '../data/site';
import BrandMark from './BrandMark.astro';
---

<footer class="site-footer">
  <div class="site-footer__inner shell">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Clever Cat Company home">
        <BrandMark />
        <span class="brand__name">Clever Cat <span>Company</span></span>
      </a>
      <p>{site.domain}</p>
      <p class="footer-business">Our businesses: <a href={site.business.url}>{site.business.name}</a></p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      {site.footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-contact">
      <a href={contactEmailHref}>{site.contact.email}</a>
      <p>Focused work. Lasting value.</p>
    </div>
  </div>
</footer>

<style>
  .footer-business a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--purple);
    text-underline-offset: 4px;
  }

  .footer-business a:hover {
    color: var(--purple-bright);
  }
</style>
