---
import ArrowIcon from './ArrowIcon.astro';
---
<section class="hero shell">
  <div class="hero__copy">
    <p class="hero__eyebrow">Independent thinking. Practical work.</p>
    <h1>Clever solutions.<br />Real results.</h1>
    <p>Software, connected systems, and hands-on ideas—brought together with focus, care, and follow-through.</p>
    <div class="hero__actions">
      <a class="button button--primary" href="/work/"><span>Explore the work</span><ArrowIcon class="button__icon" /></a>
      <a class="text-link" href="/about/"><span>Meet the company</span><ArrowIcon class="text-link__icon" /></a>
    </div>
    <p class="hero__signature">Engineered to Lead</p>
  </div>
  <div class="hero__media" aria-hidden="true">
    <img src="/images/brand/lion-hero-1254.webp" srcset="/images/brand/lion-hero-480.webp 480w, /images/brand/lion-hero-768.webp 768w, /images/brand/lion-hero-1254.webp 1254w" sizes="(max-width: 620px) 70vw, (max-width: 840px) 44vw, 48vw" alt="" width="1254" height="1254" fetchpriority="high" />
  </div>
</section>
