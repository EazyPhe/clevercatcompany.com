---
import ArrowIcon from './ArrowIcon.astro';
---
<section class="hero shell">
  <div class="hero__copy">
    <p class="hero__eyebrow">Independent thinking. Practical work.</p>
    <h1>Clever solutions.<br />Real results.</h1>
    <p>Software, connected systems, and hands-on ideas—brought together with focus, care, and follow-through.</p>
    <div class="hero__actions">
      <a class="button button--primary" href="/work/"><span>Explore the work</span><ArrowIcon class="button__icon" /></a>
      <a class="text-link" href="/about/"><span>Meet the company</span><ArrowIcon class="text-link__icon" /></a>
    </div>
  </div>
  <div class="hero__media" aria-hidden="true">
    <div class="hero__halo"></div>
    <img src="/images/hero-sculpture.png" alt="" width="1536" height="1024" fetchpriority="high" />
  </div>
</section>
